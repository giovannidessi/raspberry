# --- Telegram -------------------------------------------------------------
# 1. Su Telegram scrivi a @BotFather -> /newbot -> copia il token qui sotto
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2. Scrivi un messaggio qualsiasi al tuo bot, poi apri
#    https://api.telegram.org/bot<TOKEN>/getUpdates e copia "chat":{"id": ...}
TELEGRAM_CHAT_ID=123456789

# --- Scheduler ------------------------------------------------------------
# Ogni quanti minuti girano tutte le ricerche attive (default: 60 = ogni ora)
CARHUNT_INTERVAL_MINUTES=60
# Esegue subito un giro all'avvio del container
CARHUNT_RUN_ON_START=false

# --- Rete / porta ---------------------------------------------------------
CARHUNT_PORT=8080
TZ=Europe/Rome

# --- Scraping -------------------------------------------------------------
# Pausa (secondi) fra una richiesta e l'altra verso lo stesso portale
CARHUNT_REQUEST_DELAY=1.5
CARHUNT_HTTP_TIMEOUT=25
